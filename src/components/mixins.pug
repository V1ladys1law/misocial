mixin menu(menuItems)
    button.burger(type="button" aria-label="Toggle menu")
        svg(viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
            path(d="M3 12H21M3 6H21M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
    
    .navigation
        .logo
            a(href="index.html")
                img(src="assets/images/Symbol.svg", alt="logomisocial")
                span.nazva misocial
        .lopata
            .x 
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" width="30" height="30">
                <path fill="rgb(255, 255, 255)" d="M504.6 148.5C515.9 134.9 514.1 114.7 500.5 103.4C486.9 92.1 466.7 93.9 455.4 107.5L320 270L184.6 107.5C173.3 93.9 153.1 92.1 139.5 103.4C125.9 114.7 124.1 134.9 135.4 148.5L278.3 320L135.4 491.5C124.1 505.1 125.9 525.3 139.5 536.6C153.1 547.9 173.3 546.1 184.6 532.5L320 370L455.4 532.5C466.7 546.1 486.9 547.9 500.5 536.6C514.1 525.3 515.9 505.1 504.6 491.5L361.7 320L504.6 148.5z"/>
                </svg>

            nav
                ul.menu
                    for item in menuItems
                        li
                            a(href=item[1]) #{item[0]} 
            a(href="#" class="btn") get started

